# Папка с дообученной моделью MiniLM (экспортированной из Colab)
EMBEDDING_MODEL_PATH=./ml/model

# Имя/путь модели для фидбека. Можно оставить HF-репозиторий —
# transformers сам скачает веса при первом запуске.
FEEDBACK_MODEL_NAME=microsoft/Phi-3-mini-4k-instruct

# Список разрешённых origin для CORS, через запятую.
# На локальной разработке — адрес, с которого отдаётся frontend.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# true/false — отключить реальный вызов LLM и возвращать заглушку
# (удобно, пока Phi-3-mini ещё не подключена или не умещается в память)
FEEDBACK_MOCK=true
